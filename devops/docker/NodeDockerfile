# sha256 as of 2026-06-26
FROM node:26.4.0-trixie@sha256:b46a10d964ad15136ebdf9012142131481caa0697d7a4d4eafe4bbabd818f876 AS node-assets

ARG USERID

COPY devops/docker/node-start.sh /usr/bin/node-start.sh

RUN apt-get update && apt-get install -y --no-install-recommends \
    jq \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN getent passwd "${USERID}" || useradd --create-home --no-log-init --uid "${USERID}" pft_node

USER ${USERID}
CMD [ "/usr/bin/node-start.sh" ]
