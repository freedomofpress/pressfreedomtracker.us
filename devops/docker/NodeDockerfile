# sha256 as of 2026-07-15
FROM node:26.5.0-trixie@sha256:0473e7dc433a1310f436edee02aa79737ec78a4b345433ab0963d4a256f9ad85 AS node-assets

ARG USERID

COPY devops/docker/node-start.sh /usr/bin/node-start.sh

RUN apt-get update && apt-get install -y --no-install-recommends \
    jq \
    && rm -rf /var/lib/apt/lists/*

RUN getent passwd "${USERID}" || useradd --create-home --no-log-init --uid "${USERID}" pft_node

# Installed globally so it resolves for the unprivileged user below. The version
# is pinned to the "packageManager" field in package.json.
RUN npm install --global pnpm@11.20.0

# Pre-created so the named volume mounted here inherits this ownership and the
# unprivileged user can write to it.
RUN mkdir -p /pnpm-store && chown "${USERID}" /pnpm-store

USER ${USERID}
CMD [ "/usr/bin/node-start.sh" ]
