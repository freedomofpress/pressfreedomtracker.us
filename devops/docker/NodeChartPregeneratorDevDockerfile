# sha256 as of 2026-07-15
FROM node:26.5.0-trixie@sha256:0473e7dc433a1310f436edee02aa79737ec78a4b345433ab0963d4a256f9ad85 AS node-assets

ARG USERID

RUN echo "deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware" > /etc/apt/sources.list && \
    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        fontconfig \
        ttf-mscorefonts-installer && \
    fc-cache -f && \
    rm -rf /var/lib/apt/lists/*


COPY devops/docker/node-pregenerator-start.sh /usr/bin/node-pregenerator-start.sh
RUN getent passwd "${USERID}" || useradd --create-home --no-log-init --uid "${USERID}" pft_node

# Installed globally so it resolves for the unprivileged user below. The version
# is pinned to the "packageManager" field in package.json.
RUN npm install --global pnpm@11.20.0

WORKDIR /app

RUN chown -R "${USERID}" /app
USER ${USERID}

COPY chart_pregenerator/package.json ./
COPY chart_pregenerator/pnpm-lock.yaml ./
# Carries the allowBuilds approvals; without it pnpm silently skips esbuild's
# postinstall and its binary never lands.
COPY chart_pregenerator/pnpm-workspace.yaml ./
COPY chart_pregenerator/dev.js ./
COPY chart_pregenerator/jest.config.js ./
COPY chart_pregenerator/babel.config.json ./

RUN pnpm install --frozen-lockfile
CMD [ "/usr/bin/node-pregenerator-start.sh" ]
