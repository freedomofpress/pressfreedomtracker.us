# sha256 for python:3.14.5-slim-trixie on linux/amd64 as of 2026-05-20
FROM python:3.14.5-slim-trixie@sha256:a7185a8e40af01bf891414a4df16ef10fc6000cee460a404a13da9029fe41604 AS python-base

RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    git \
    libpq-dev \
    libssl-dev \
    netcat-traditional \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY dev-requirements.txt /requirements.txt
RUN pip install --no-deps --require-hashes -r /requirements.txt

COPY devops/docker/django-start.sh /usr/local/bin
RUN  chmod +x /usr/local/bin/django-start.sh

ARG USERID
RUN getent passwd "${USERID?USERID must be supplied}" || adduser --uid "${USERID}" --disabled-password --gecos "" gcorn

RUN mkdir /django-logs /deploy && \
    chown -R "${USERID}" /django-logs /deploy

EXPOSE 8000
USER ${USERID}
CMD [ "django-start.sh" ]
