# sha256 as of 2026-07-15
FROM node:26.5.0-trixie@sha256:0473e7dc433a1310f436edee02aa79737ec78a4b345433ab0963d4a256f9ad85 AS node-assets

ARG USERID

RUN echo "deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware" > /etc/apt/sources.list && \
    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        fontconfig \
        ttf-mscorefonts-installer && \
    fc-cache -f && \
    rm -rf /var/lib/apt/lists/*

RUN getent passwd "${USERID}" || useradd --create-home --no-log-init --uid "${USERID}" pft_node
COPY chart_pregenerator /opt/chart-pregenerator
COPY ./client /opt/chart-pregenerator/client
RUN chown -R "${USERID}" /opt/chart-pregenerator
WORKDIR /opt/chart-pregenerator

USER ${USERID}

RUN npm install
RUN npm run build

CMD ["node", "./build/server.js"]
