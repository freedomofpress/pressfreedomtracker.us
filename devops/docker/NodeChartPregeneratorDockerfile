# sha256 as of 2026-06-26
FROM node:26.4.0-trixie@sha256:b46a10d964ad15136ebdf9012142131481caa0697d7a4d4eafe4bbabd818f876 AS node-assets

ARG USERID

RUN echo "deb http://deb.debian.org/debian trixie main contrib non-free non-free-firmware" > /etc/apt/sources.list && \
    echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        fontconfig \
        ttf-mscorefonts-installer && \
    fc-cache -f && \
    rm -rf /var/lib/apt/lists/*

# Ensure npm can correctly set cache information in ~/.npm
ENV HOME=/home/node
RUN mkdir -p /home/node/.npm

RUN getent passwd "${USERID}" || useradd --create-home --no-log-init --uid "${USERID}" pft_node
COPY chart_pregenerator /opt/chart-pregenerator
COPY ./client /opt/chart-pregenerator/client
RUN chown -R "${USERID}" /opt/chart-pregenerator
RUN chown -R "${USERID}" /home/node/.npm
WORKDIR /opt/chart-pregenerator
USER ${USERID}

RUN npm install
RUN npm run build

CMD ["node", "./build/server.js"]
